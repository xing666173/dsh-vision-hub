{
  "name": "dsh-bridge-preview",
  "version": "0.1.1",
  "description": "为 dsh-tool-vision 桥接导出的图片提供对话内联预览:用户粘贴的图片在气泡中显示缩略图,不改变桥接文本与模型行为",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "client-plugin",
    "ui",
    "vision",
    "image-preview",
    "tool-vision"
  ],
  "homepage": "https://github.com/xing666173/dsh-vision-hub/tree/main/bridge-preview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xing666173/dsh-vision-hub.git"
  },
  "engines": {
    "node": ">=20.18"
  },
  "license": "MIT"
}
